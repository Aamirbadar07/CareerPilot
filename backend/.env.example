ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
DATABASE_URL=
RAPIDAPI_KEY=
GREENHOUSE_BOARDS=gitlab
PROFILE_TTL_HOURS=24
FRONTEND_ORIGIN=http://localhost:3000
# Proxies in front of the app, each appending one X-Forwarded-For entry: 1 on Cloud Run or
# Render, 2 behind an extra load balancer or CDN, 0 when nothing proxies it.
TRUSTED_PROXY_HOPS=1
# Primary LLM provider: google (default), anthropic, deepseek, or openrouter
LLM_PROVIDER=google
# Comma-separated Gemini API keys from https://aistudio.google.com/apikey for automatic failover rotation
GOOGLE_API_KEY=
# Models tried in order: when quota on one is exhausted, the next is tried automatically
GOOGLE_MODEL=gemini-3.8-flash,gemini-2.5-flash
# Optional ultimate fallback providers
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
