ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
DATABASE_URL=
RAPIDAPI_KEY=
GREENHOUSE_BOARDS=gitlab
PROFILE_TTL_HOURS=24
FRONTEND_ORIGIN=http://localhost:3000
# Proxies in front of the app, each appending one X-Forwarded-For entry: 1 on Cloud Run or
# Render, 2 behind an extra load balancer or CDN, 0 when nothing proxies it.
TRUSTED_PROXY_HOPS=1
# To use Gemini instead of Claude: LLM_PROVIDER=google and a key from https://aistudio.google.com/apikey
LLM_PROVIDER=anthropic
GOOGLE_API_KEY=
# One model, or several separated by commas. Gemini's free tier counts requests and tokens
# per model, so each extra model here is extra headroom: when one is spent for the day the
# next is used instead. List yours with:
#   curl -s "https://generativelanguage.googleapis.com/v1beta/models?key=$GOOGLE_API_KEY" | grep '"name"'
GOOGLE_MODEL=gemini-3.8-flash
